# Public GeoServer routes share the server-level maintenance gate.
location /geoserver/ {
    proxy_pass http://geoserver.dockerized.io:8080/geoserver/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
}

location /wms {
    proxy_pass http://geoserver.dockerized.io:8080/geoserver/meteohub/wms;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location /wms/cache {
    proxy_pass http://geoserver.dockerized.io:8080/geoserver/gwc/service/wms;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
}
